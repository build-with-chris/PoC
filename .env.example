# Grundwerte des Finanzreglers als JSON in einer Zeile.
#
# Hier stehen nur BEISPIELWERTE. Die echten Zahlen gehoeren nie in diese Datei,
# sondern lokal in .env (wird nicht committet) und online in Vercel unter
# Settings > Environment Variables. Nach einer Aenderung in Vercel neu deployen.
#
# Es reicht, nur die Felder anzugeben, die vom Beispiel abweichen.
# Alle Felder mit aktuellem Stand ausgeben:  npm run werte:vorlage
#
# activity: Betrieb pro Monat in Prozent, beginnend mit Maerz (12 Werte)
# winterMonths: Wintermonate (geheizt, Cafe nur an Showtagen), beginnend mit Maerz (12 Werte)
PEPE_DOME_WERTE={"ticketPrice":16,"guestsPerShow":70}
